# Browser API base, including /api. Default uses the Vite proxy.
VITE_API_BASE_URL=/api
# Google OAuth2 Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=164354959561-84vaff9lo56ummq04itrgq642kmjd4qo.apps.googleusercontent.com
# Browser key for Google Maps JavaScript API; restrict by HTTP referrer and enabled API in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
# Backend target for npm run dev (not exposed to the browser).
API_PROXY_TARGET=http://localhost:8081
